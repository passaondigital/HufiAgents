HUFI_DATABASE_URL=sqlite:///./run/hufiagents.sqlite3
HUFI_WORKSPACE_ROOT=./workspaces
HUFI_DEFAULT_PROVIDER=hufi-local-router
HUFI_LOCAL_ROUTER_BASE_URL=http://127.0.0.1:8090/v1
HUFI_LOCAL_MODEL=hufi-qwen9-fast
HUFI_OLLAMA_BASE_URL=http://127.0.0.1:11434
HUFI_OLLAMA_MODEL=qwen3:8b
HUFI_MAX_CONCURRENT_TASKS=2
# Scheduler poll interval; raise on a memory/CPU-constrained host to reduce
# continuous idle DB polling (docs/XXL-AUDIT.md low-resource profile).
HUFI_POLL_INTERVAL_SECONDS=0.1
HUFI_HEARTBEAT_TIMEOUT_SECONDS=120
HUFI_HEARTBEAT_INTERVAL_SECONDS=30
HUFI_MODEL_TIMEOUT_SECONDS=180
# Required only to resolve approvals; inject a random secret locally.
HUFI_APPROVAL_TOKEN=
# Phase 2 git/PR workflow (docs/PHASE2-GIT-PR-WORKFLOW.md). All empty by
# default = push/PR stay disabled; a task can never override these values.
HUFI_GIT_REMOTE_URL=
HUFI_GITHUB_REPO=
HUFI_GITHUB_BASE_BRANCH=main
# Scoped PAT for the `integrator` agent only; never the host's own `gh auth`
# session. Set via a local secret store, not this file.
HUFI_GITHUB_TOKEN=
# V1 web UI/API login (hufiagents/auth.py, docs/DECISIONS.md ADR-015). Both
# empty (default) disables auth entirely -- fine for local dev, never for a
# publicly reachable deployment. Generate the hash with:
#   uv run python -c "from hufiagents.auth import hash_password; print(hash_password('...'))"
HUFI_ADMIN_USERNAME=
HUFI_ADMIN_PASSWORD_HASH=
# Random, e.g.: uv run python -c "import secrets; print(secrets.token_hex(32))"
HUFI_SESSION_SECRET=
# Only ever false for local HTTP testing before a TLS reverse proxy is in
# front of the app.
HUFI_COOKIE_SECURE=true
# Loopback bind port for `hufiagents serve`; the host is always 127.0.0.1.
HUFI_PORT=8765
